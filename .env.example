# Database
MONGODB_URI=mongodb://localhost:27017/zodyk

# Cache (optional for scaffold, required for v1.5)
REDIS_URL=redis://localhost:6379

# Auth (generate before production: openssl rand -base64 32)
AUTH_SECRET=change-me-in-production
AUTH_URL=http://localhost:5001

# Registration
ALLOW_REGISTRATION=false

# Bootstrap admin (used by pnpm seed)
ADMIN_EMAIL=admin@zodyk.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Super Admin

# App URLs
ADMIN_URL=http://localhost:5001
WEBSITE_URL=http://localhost:5003
NEXT_PUBLIC_ALLOW_REGISTRATION=false

# Express API (apps/api) — Docker / self-hosted
API_PORT=5002
API_URL=http://localhost:5002
# Admin Next.js rewrites /api/v1/* here (defaults to http://127.0.0.1:5002 in development)
API_UPSTREAM_URL=http://127.0.0.1:5002
# Comma-separated browser origins allowed to call the API with credentials.
# Required in production. An empty list rejects every browser Origin (credentialed
# requests included). Requests with no Origin header (server-to-server, curl) still
# succeed. Development allows every origin when this list is empty.
CORS_ORIGINS=http://localhost:5001,http://localhost:5003
# Shared by the website (verifies it) and the API (sends it on theme publish and menu changes).
# Required in production. POST /api/revalidate returns 503 when this is unset, and 401
# when Authorization is not `Bearer $REVALIDATE_SECRET`.
# Generate: openssl rand -base64 32
REVALIDATE_SECRET=
# Optional: large upload size / proxy timeout tuning on the API process
API_BODY_LIMIT=100mb
API_REQUEST_TIMEOUT_MS=120000

# Email (magic links + password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@zodyk.local

# OAuth (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Encryption key for MFA secrets at rest (openssl rand -hex 32)
ENCRYPTION_KEY=change-me-32-byte-hex-key-for-dev-only00

# Theme storage: local (repo themes/) or r2 (Cloudflare R2)
# Defaults to local when NODE_ENV !== production
THEME_STORAGE=local
# Absolute or repo-relative root for local theme files (default: themes/)
THEME_LOCAL_ROOT=themes

# Object storage (Cloudflare R2) — required for media; required for themes when THEME_STORAGE=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public CDN/custom domain URL for browser-accessible assets (required for media)
R2_PUBLIC_URL=
R2_ENDPOINT=
# Media library storage quota display (bytes, default 100 GB)
MEDIA_STORAGE_QUOTA_BYTES=107374182400

# Background removal service (phase 2 — BiRefNet / RMBG-2.0)
BG_REMOVAL_SERVICE_URL=
BG_REMOVAL_MODEL=birefnet

# Payments (optional — prefer Settings → Payments in admin UI)
# Active gateway: stripe | razorpay | paypal | cashfree | phonepe | payu | custom
PAYMENTS_GATEWAY=
PAYMENTS_MODE=test

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# PayPal (adapter pending — credentials reserved)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Cashfree (adapter pending)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# PhonePe (adapter pending)
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=

# PayU (adapter pending)
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_AUTH_HEADER=

# Custom HTTP gateway
PAYMENTS_CUSTOM_CHECKOUT_URL=
PAYMENTS_CUSTOM_REFUND_URL=
PAYMENTS_CUSTOM_WEBHOOK_SECRET=
PAYMENTS_CUSTOM_API_KEY=
