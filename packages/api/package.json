{
  "name": "@zodyk/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./media": {
      "types": "./src/media/handlers.ts",
      "default": "./src/media/handlers.ts"
    },
    "./settings": {
      "types": "./src/settings/handlers.ts",
      "default": "./src/settings/handlers.ts"
    },
    "./payments": {
      "types": "./src/payments/handlers.ts",
      "default": "./src/payments/handlers.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run && node --import tsx --test src/website-cache.test.ts"
  },
  "dependencies": {
    "@zodyk/auth": "workspace:*",
    "@zodyk/core": "workspace:*",
    "@zodyk/database": "workspace:*",
    "@zodyk/media": "workspace:*",
    "@zodyk/payments": "workspace:*",
    "@zodyk/seo": "workspace:*",
    "@zodyk/theme-engine": "workspace:*",
    "@zodyk/theme-language": "workspace:*",
    "mongoose": "^8.15.1"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
